DATABASE_URL=sqlite:///dynasty.db
# FANTASYPROS_API_KEY=
# PFF_API_KEY=
USER_AGENT=DynastyFootballModel/0.3 (open-source dynasty FF aggregator; https://github.com/pstiehl/Dynasty-Football-Model)
REQUEST_TIMEOUT_SECONDS=30

# Web analytics beacon (docs/ANALYTICS.md). Unset = no beacon is emitted at
# all and the built site is byte-identical, which is what every local build
# and every fork should want. In CI this comes from the CF_ANALYTICS_TOKEN
# repository secret -- NEVER commit a real token here.
# DFM_ANALYTICS_TOKEN=
# DFM_ANALYTICS_PROVIDER=cloudflare   # or plausible / fathom / none
